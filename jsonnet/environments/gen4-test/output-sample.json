          "namespace": "default"
        }
      ]
    },
    "metacontroller": {
      "compute": {
        "apiVersion": "metacontroller.k8s.io/v1alpha1",
        "kind": "CompositeController",
        "metadata": {
          "name": "compute-composite"
        },
        "spec": {
          "childResources": [
            {
              "apiVersion": "apps/v1",
              "resource": "deployments"
            },
            {
              "apiVersion": "v1",
              "resource": "services"
            },
            {
              "apiVersion": "kafka.strimzi.io/v1beta2",
              "resource": "kafkatopics"
            },
            {
              "apiVersion": "kafka.strimzi.io/v1beta2",
              "resource": "kafkaconnectors"
            },
            {
              "apiVersion": "policy/v1",
              "resource": "poddisruptionbudgets"
            }
          ],
          "generateSelector": true,
          "hooks": {
            "sync": {
              "webhook": {
                "url": "http://gen4-webhooks.default.svc.cluster.local:3000/sync-compute"
              }
            }
          },
          "parentResource": {
            "apiVersion": "v1",
            "resource": "configmaps"
          },
          "resyncPeriodSeconds": 60
        }
      },
      "pvcBackup": {
        "apiVersion": "metacontroller.k8s.io/v1alpha1",
        "kind": "DecoratorController",
        "metadata": {
          "name": "pvc-backup-decorator"
        },
        "spec": {
          "hooks": {
            "sync": {
              "webhook": {
                "url": "http://gen4-webhooks.default.svc.cluster.local:3000/sync-pvc-decorator"
              }
            }
          },
          "resources": [
            {
              "apiVersion": "v1",
              "labelSelector": {
                "matchLabels": {
                  "app.kubernetes.io/component": "database"
                }
              },
              "resource": "persistentvolumeclaims"
            }
          ],
          "resyncPeriodSeconds": 120
        }
      },
      "storage": {
        "apiVersion": "metacontroller.k8s.io/v1alpha1",
        "kind": "CompositeController",
        "metadata": {
          "name": "storage-composite"
        },
        "spec": {
          "childResources": [
            {
              "apiVersion": "apps/v1",
              "resource": "statefulsets"
            },
            {
              "apiVersion": "v1",
              "resource": "services"
            },
            {
              "apiVersion": "v1",
              "resource": "secrets"
            },
            {
              "apiVersion": "batch/v1",
              "resource": "jobs"
            },
            {
              "apiVersion": "policy/v1",
              "resource": "poddisruptionbudgets"
            }
          ],
          "generateSelector": true,
          "hooks": {
            "sync": {
              "webhook": {
                "url": "http://gen4-webhooks.default.svc.cluster.local:3000/sync-storage"
              }
            }
          },
          "parentResource": {
            "apiVersion": "v1",
            "resource": "secrets"
          },
          "resyncPeriodSeconds": 60
        }
      }
    },

                      "memory": "256Mi"
                    }
                  }
                }
              ],
              "serviceAccountName": "deployment-server"
            }
          }
        }
      },
      "service": {
        "apiVersion": "v1",
        "kind": "Service",
        "metadata": {
          "name": "multienv-provisioner",
